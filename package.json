{
  "name": "epistola-suite",
  "private": true,
  "description": "Epistola Suite - Document generation platform",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b modules/editor",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "lint:css": "stylelint 'modules/**/*.css' 'apps/**/*.css'",
    "license:headers": "python3 scripts/license-headers.py --fix",
    "license:headers:check": "python3 scripts/license-headers.py --check",
    "license:check": "pnpm license:headers:check && mise exec -- reuse --no-multiprocessing lint",
    "agents:check": "python3 -m unittest scripts/test_agents_check.py && python3 scripts/agents_check.py",
    "vulnerabilities:check": "python3 -m unittest scripts/test_vulnerability_advisories.py && python3 scripts/vulnerability_advisories.py check",
    "vulnerabilities:render": "python3 scripts/vulnerability_advisories.py render",
    "vulnerabilities:export": "python3 scripts/vulnerability_advisories.py export-osv build/osv",
    "vulnerabilities:export-vex": "python3 scripts/vulnerability_advisories.py export-vex build/vex",
    "setup:github-mcp": "pnpm --filter @epistola/gh-mcp run setup"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@scalar/api-reference": "^1.69.0",
    "htmx.org": "2.0.10"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.2"
}
