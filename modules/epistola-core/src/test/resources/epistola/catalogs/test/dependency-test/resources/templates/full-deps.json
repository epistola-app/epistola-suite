{
  "schemaVersion": 8,
  "resource": {
    "type": "template",
    "key": "full-deps",
    "name": "Full Dependencies",
    "templateModel": {
      "modelVersion": 1,
      "root": "n-root",
      "themeRef": {
        "type": "override",
        "themeKey": "test-theme"
      },
      "nodes": {
        "n-root": {
          "id": "n-root",
          "type": "root",
          "slots": [
            "s-root-children"
          ]
        },
        "n-stencil": {
          "id": "n-stencil",
          "type": "stencil",
          "slots": [],
          "props": {
            "stencilKey": "header-with-logo"
          }
        },
        "n-body": {
          "id": "n-body",
          "type": "text",
          "slots": [],
          "props": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Body text"
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "slots": {
        "s-root-children": {
          "id": "s-root-children",
          "nodeId": "n-root",
          "name": "children",
          "children": [
            "n-stencil",
            "n-body"
          ]
        }
      }
    },
    "variants": [
      {
        "name": "Nederlands",
        "attributes": {
          "language": "nl"
        },
        "isDefault": true,
        "key": "dutch"
      },
      {
        "name": "English",
        "attributes": {
          "language": "en"
        },
        "isDefault": false,
        "key": "english"
      }
    ]
  }
}
