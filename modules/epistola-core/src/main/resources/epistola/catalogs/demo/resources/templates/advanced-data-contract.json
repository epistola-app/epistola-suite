{
  "schemaVersion": 6,
  "resource": {
    "type": "template",
    "slug": "advanced-data-contract",
    "name": "Advanced Data Contract",
    "themeId": "corporate",
    "dataModel": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "$defs": {
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string",
              "description": "Street and house number"
            },
            "postalCode": {
              "type": "string"
            },
            "city": {
              "type": "string"
            }
          },
          "required": ["street", "postalCode", "city"]
        },
        "contactDetails": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "format": "email"
            },
            "phoneNumber": {
              "type": "string"
            }
          },
          "required": ["email"]
        },
        "person": {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/contactDetails"
            }
          ],
          "properties": {
            "firstName": {
              "type": "string"
            },
            "lastName": {
              "type": "string"
            },
            "address": {
              "$ref": "#/$defs/address"
            }
          },
          "required": ["firstName", "lastName", "address"]
        },
        "organization": {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/$defs/contactDetails"
            }
          ],
          "properties": {
            "organizationName": {
              "type": "string"
            },
            "registrationNumber": {
              "type": "string"
            },
            "address": {
              "$ref": "#/$defs/address"
            }
          },
          "required": ["organizationName", "registrationNumber", "address"]
        }
      },
      "properties": {
        "caseReference": {
          "type": "string",
          "description": "Reference shown on the case"
        },
        "applicant": {
          "$ref": "#/$defs/person"
        },
        "subject": {
          "oneOf": [
            {
              "$ref": "#/$defs/person"
            },
            {
              "$ref": "#/$defs/organization"
            }
          ]
        },
        "alternateSubjects": {
          "type": "array",
          "description": "Different union variants in one collection",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/person"
              },
              {
                "$ref": "#/$defs/organization"
              }
            ]
          },
          "minItems": 1
        },
        "correspondenceAddress": {
          "description": "An optional address represented as an anyOf nullable union",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/address"
            }
          ]
        },
        "deliveryRoutes": {
          "type": "array",
          "description": "Routes containing ordered groups of addresses",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/address"
            }
          }
        }
      },
      "required": [
        "caseReference",
        "applicant",
        "subject",
        "alternateSubjects",
        "deliveryRoutes"
      ]
    },
    "dataExamples": [
      {
