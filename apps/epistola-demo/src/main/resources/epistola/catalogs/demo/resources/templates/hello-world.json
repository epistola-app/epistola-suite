{
  "schemaVersion": 8,
  "resource": {
    "type": "template",
    "key": "hello-world",
    "name": "Hello World",
    "description": "A minimal template to get started. Contains a heading and a paragraph with data binding.",
    "pdfaEnabled": false,
    "themeKey": "corporate",
    "dataModel": {
      "type": "object",
      "properties": {
        "companyName": {
          "type": "string",
          "description": "Company name shown in the header"
        },
        "name": {
          "type": "string",
          "description": "Name of the person to greet"
        },
        "message": {
          "type": "string",
          "description": "A personal message"
        }
      }
    },
    "dataExamples": [
      {
        "key": "default",
        "name": "Default",
        "data": {
          "companyName": "Globex Corporation",
          "name": "World",
          "message": "Welcome to Epistola! This template was installed from a catalog."
        }
      }
    ],
    "templateModel": {
      "modelVersion": 1,
      "root": "n-root",
      "themeRef": {
        "type": "inherit"
      },
      "nodes": {
        "n-root": {
          "id": "n-root",
          "type": "root",
          "slots": [
            "s-root-children"
          ]
        },
        "n-header": {
          "id": "n-header",
          "type": "stencil",
          "slots": [
            "n-header:children"
          ],
          "props": {
            "stencilKey": "company-header",
            "paramsAlias": "params",
            "parameterBindings": {
              "companyName": "companyName"
            }
          }
        },
        "n-heading": {
          "id": "n-heading",
          "type": "text",
          "slots": [],
          "props": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "heading",
                  "attrs": {
                    "level": 1
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Hello, "
                    },
                    {
                      "type": "expression",
                      "attrs": {
                        "expression": "name"
                      }
                    },
                    {
                      "type": "text",
                      "text": "!"
                    }
                  ]
                }
              ]
            }
          }
        },
        "n-body": {
          "id": "n-body",
          "type": "text",
          "slots": [],
          "props": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "expression",
                      "attrs": {
                        "expression": "message"
                      }
                    }
                  ]
                }
              ]
            }
          },
          "stylePreset": "muted"
        }
      },
      "slots": {
        "s-root-children": {
          "id": "s-root-children",
          "nodeId": "n-root",
          "name": "children",
          "children": [
            "n-header",
            "n-heading",
            "n-body"
          ]
        },
        "n-header:children": {
          "id": "n-header:children",
          "nodeId": "n-header",
          "name": "children",
          "children": []
        }
      }
    },
    "variants": [
      {
        "key": "default",
        "name": "Default",
        "attributes": {},
        "isDefault": true
      }
    ]
  }
}
