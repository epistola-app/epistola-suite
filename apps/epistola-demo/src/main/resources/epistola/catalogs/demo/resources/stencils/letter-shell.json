{
  "schemaVersion": 8,
  "resource": {
    "type": "stencil",
    "key": "letter-shell",
    "name": "Letter Shell",
    "description": "A letter shell built from the Letterhead stencil, with a body that templates fill. Its company name reaches the letterhead and, through the body placeholder, the template's fill.",
    "tags": ["layout", "letter"],
    "content": {
      "modelVersion": 1,
      "root": "n-root",
      "themeRef": {
        "type": "inherit"
      },
      "nodes": {
        "n-root": {
          "id": "n-root",
          "type": "root",
          "slots": ["s-root-children"]
        },
        "n-letterhead": {
          "id": "n-letterhead",
          "type": "stencil",
          "slots": ["s-letterhead-children"],
          "props": {
            "stencilKey": "letterhead",
            "parameterBindings": {
              "companyName": "params.companyName"
            }
          }
        },
        "n-ph-body-default-text": {
          "id": "n-ph-body-default-text",
          "type": "text",
          "slots": [],
          "props": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Default body text"
                    }
                  ]
                }
              ]
            }
          }
        },
        "n-ph-body": {
          "id": "n-ph-body",
          "type": "placeholder",
          "slots": ["s-ph-body-default", "s-ph-body-fill"],
          "props": {
            "name": "body",
            "description": "Body content",
            "kind": "block",
            "passParameters": true
          }
        }
      },
      "slots": {
        "s-root-children": {
          "id": "s-root-children",
          "nodeId": "n-root",
          "name": "children",
          "children": ["n-letterhead", "n-ph-body"]
        },
        "s-letterhead-children": {
          "id": "s-letterhead-children",
          "nodeId": "n-letterhead",
          "name": "children",
          "children": []
        },
        "s-ph-body-default": {
          "id": "s-ph-body-default",
          "nodeId": "n-ph-body",
          "name": "default",
          "children": ["n-ph-body-default-text"]
        },
        "s-ph-body-fill": {
          "id": "s-ph-body-fill",
          "nodeId": "n-ph-body",
          "name": "fill",
          "children": []
        }
      }
    },
    "parameterSchema": {
      "type": "object",
      "properties": {
        "companyName": {
          "type": "string",
          "description": "Company name shown in the letterhead and passed to the body",
          "default": "Acme Corporation"
        }
      },
      "required": ["companyName"]
    }
  }
}
