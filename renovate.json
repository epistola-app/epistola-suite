{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "ignorePaths": ["**/test/resources/**"],
  "constraints": { "pnpm": "11.18.0", "node": "24.18.0" },
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "all non-major dependencies",
    "groupSlug": "non-major"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned Graphify tooling used by scripts/graphify.sh",
      "managerFilePatterns": ["/^scripts\\/graphify\\.sh$/"],
      "matchStrings": [
        "UV_VERSION=\\\"(?<currentValue>[^\\\"]+)\\\" # renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)",
        "GRAPHIFY_VERSION=\\\"(?<currentValue>[^\\\"]+)\\\" # renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)"
      ],
      "datasourceTemplate": "{{datasource}}",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Default group for major updates (specific groups below override)",
      "matchUpdateTypes": ["major"],
      "groupName": "all non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "description": "Default group for minor/patch updates (specific groups below override)",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "non-major",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep Graphify upgrades reviewable because extraction semantics can change",
      "matchPackageNames": ["graphifyy", "astral-sh/uv"],
      "groupName": "graphify tooling",
      "groupSlug": "graphify-tooling",
      "automerge": false
    },
    {
      "description": "Group epistola-contract packages (server SDK + editor model) together",
      "matchPackageNames": ["app.epistola.contract*", "@epistola.app/**"],
      "groupName": "epistola-contract",
      "groupSlug": "epistola-contract",
      "automerge": false
    },
    {
      "description": "Group toolchain updates (Kotlin, Gradle, Kover, Java, Node, pnpm, TypeScript) into a separate PR",
      "matchPackageNames": [
        "org.jetbrains.kotlin*",
        "org.jetbrains.kotlinx.kover*",
        "org.jetbrains.kotlinx:kover-gradle-plugin",
        "gradle",
        "java",
        "node",
        "pnpm",
        "typescript"
      ],
      "groupName": "toolchain",
      "groupSlug": "toolchain",
      "automerge": false
    },
    {
      "description": "Group all GitHub Actions updates (minor, major, digests) into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "automerge": false
    }
  ],
  "gradle": {
    "fileMatch": [
      "(^|/)build\\.gradle\\.kts$",
      "(^|/)settings\\.gradle\\.kts$",
      "(^|/)gradle/libs\\.versions\\.toml$"
    ]
  }
}
